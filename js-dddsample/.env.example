## ── Database driver ───────────────────────────────────────────────────────────
## Options: inmemory | mongodb | mysql
DB_DRIVER=inmemory

## ── MongoDB (only needed when DB_DRIVER=mongodb) ─────────────────────────────
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dddsample

## ── MySQL (only needed when DB_DRIVER=mysql) ──────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=dddsample
MYSQL_PASSWORD=secret
MYSQL_DATABASE=dddsample

## ── Messaging driver ──────────────────────────────────────────────────────────
## Options: local | rabbitmq
MQ_DRIVER=local

## ── RabbitMQ (only needed when MQ_DRIVER=rabbitmq) ───────────────────────────
RABBITMQ_URL=amqp://localhost

## ── Server ────────────────────────────────────────────────────────────────────
PORT=8080
