{
  "name": "js-dddsample",
  "version": "1.0.0",
  "description": "JavaScript DDD Sample - port of the Java DDD Sample application",
  "main": "src/server/app.js",
  "scripts": {
    "start": "node src/server/app.js",
    "test": "jest --testPathPattern=test/ --forceExit",
    "test:coverage": "jest --testPathPattern=test/ --forceExit --coverage",
    "test:watch": "jest --watch",
    "test:acceptance": "playwright test",
    "test:acceptance:ui": "playwright test --ui"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "@playwright/test": "^1.44.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/test/**/*.test.js"
    ]
  }
}
